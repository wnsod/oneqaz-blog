---
import PostLayout from '../../layouts/PostLayout.astro';

// 주간 원장 무결성 앵커 — 데이터 정본은 vault anchors/prediction_ledger_chain.csv 마지막 행.
const anchorLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: 'OneQAZ prediction ledger anchor',
  dateCreated: '2026-08-18T23:07:00+09:00',
  inLanguage: 'ko',
  'oneqaz:anchor': {
    type: 'ledger_anchor',
    anchor_day: '2026-08-16',
    latest_chain_hash: '03e6e5bb8fcaacf3f8865ce6c38db33e6ec75b524afefbac19274db8220f604d',
    recipe_version: 1,
    chain_first_day: '2026-03-22',
    verify: 'MCP get_ledger_integrity 의 recipe 로 원시 행에서 체인을 재계산해 이 해시와 대조',
  },
};
---
<PostLayout
  title="Ledger Anchor 2026-08-16"
  description="OneQAZ 예측 원장 주간 무결성 앵커. anchor_day 2026-08-16, chain hash 03e6e5bb…, OpenTimestamps 증명 포함."
  date={new Date('2026-08-18T23:07:00+09:00')}
  category="anchors"
  lang="ko"
  altUrl="/anchors/2026-08-16-en/"
  altLang="en"
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(anchorLd)} />

  <p>이 페이지는 OneQAZ 예측 원장의 주간 무결성 앵커입니다. 아래 해시는 원장 전체
  이력에 암호학적으로 연결되어 있어, 이 페이지가 공개된 시점 이후 원장의 어떤
  행도 사후 수정·삭제되면 재계산 시 이 해시와 어긋나게 됩니다. 함께 배포된
  <code>.ots</code> 파일은 이 해시가 비트코인 블록체인에 타임스탬프됐음을 증명합니다
  (<a href="https://opentimestamps.org" rel="noopener">opentimestamps.org</a> 에서 누구나 검증 가능).</p>

  <table>
    <tbody>
      <tr><th>anchor_day</th><td><code>2026-08-16</code></td></tr>
      <tr><th>latest_chain_hash</th><td><code>03e6e5bb8fcaacf3f8865ce6c38db33e6ec75b524afefbac19274db8220f604d</code></td></tr>
      <tr><th>recipe_version</th><td><code>1</code></td></tr>
      <tr><th>chain_first_day</th><td><code>2026-03-22</code></td></tr>
      <tr><th>ledger</th><td><code>mcp_analytics.prediction_ledger_hashes</code></td></tr>
    </tbody>
  </table>

  <h2>증명 파일 다운로드</h2>
  <ul>
    <li><a href="/anchors/anchor_2026-08-16.txt">anchor_2026-08-16.txt</a> — 앵커 데이·체인 해시 고정 파일 (OTS 대상)</li>
    <li><a href="/anchors/anchor_2026-08-16.txt.ots">anchor_2026-08-16.txt.ots</a> — OpenTimestamps 비트코인 타임스탬프 증명</li>
    <li><a href="/anchors/prediction_ledger_chain_2026-08-16.csv">prediction_ledger_chain_2026-08-16.csv</a> — 앵커 시점 체인 CSV 스냅샷 (2026-03-22 ~ 2026-08-16)</li>
  </ul>

  <h2>검증 방법</h2>
  <ol>
    <li><strong>타임스탬프</strong>: <code>ots verify anchor_2026-08-16.txt.ots</code>
      (또는 <a href="https://opentimestamps.org" rel="noopener">opentimestamps.org</a> 웹 검증) —
      이 해시가 이 날짜 무렵 존재했음을 비트코인 블록체인으로 확인.</li>
    <li><strong>체인 무결성</strong>: OneQAZ MCP <code>get_ledger_integrity</code> 가 반환하는
      recipe 로 원장 원시 행에서 해시체인을 재계산해, 마지막 행의
      <code>chain_hash</code> 가 위 <code>03e6e5bb…</code> 와 일치하는지 대조.</li>
    <li><strong>공개 시점</strong>: 이 페이지의 Wayback Machine 아카이브로
      공개 시각을 제3자 기록에서 확인.</li>
  </ol>
</PostLayout>
